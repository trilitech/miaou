# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.6.1"
synopsis: "A TUI framework for OCaml (full install with SDL)"
maintainer: ["Nomadic Labs <contact@nomadic-labs.com>"]
authors: ["Nomadic Labs <contact@nomadic-labs.com>"]
license: "MIT"
homepage: "https://github.com/trilitech/miaou"
bug-reports: "https://github.com/trilitech/miaou/issues"
depends: [
  "dune" {>= "3.24"}
  "miaou-core" {= version}
  "miaou-driver-term" {= version}
  "miaou-driver-web" {= version}
  "miaou-driver-sdl" {= version}
  "miaou-runner" {= version}
  "ppx_blob" {>= "0.9.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/trilitech/miaou.git"
x-maintenance-intent: ["(latest)"]
available: os != "win32" & os-distribution != "opensuse-tumbleweed"
